#: sketch_map_tool/templates/case-studies.html:21
msgid "Sketch Map Tool Use-Case in EVCA Context"
msgstr ""

#: sketch_map_tool/templates/case-studies.html:22
msgid "The Colombian Red Cross's Disaster Risk Management (DRM) CRC has continued to implement the Sketch Map Tool in their workflows for conducting EVCAs within the framework of the ongoing project „Providing humanitarian assistance to vulnerable and affected populations in Colombia“."
msgstr ""

#: sketch_map_tool/templates/case-studies.html:23
#: sketch_map_tool/templates/case-studies.html:33
#: sketch_map_tool/templates/case-studies.html:44
#: sketch_map_tool/templates/case-studies.html:54
#: sketch_map_tool/templates/case-studies.html:64
#: sketch_map_tool/templates/case-studies.html:74
#: sketch_map_tool/templates/case-studies.html:84
#: sketch_map_tool/templates/case-studies.html:94
#: sketch_map_tool/templates/case-studies.html:110
